# QUANTA Real-Time Intent Engine Environment Configuration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK_URL
PORT=3002
ENV=production

# Optional real enrichment providers - all free-tier friendly, none required.
# Without these, the corresponding engine reports NO_EXTERNAL_DATA_AVAILABLE
# / not_configured instead of guessing.
HUNTER_API_KEY=
CLEARBIT_API_KEY=
# Free registration (not a paid API): https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=
