{
  "manifest_version": 3,
  "name": "QUANTA Intent Signal Overlay",
  "short_name": "QUANTA",
  "version": "1.2.0",
  "description": "Silent Autonomous B2B buyer intent signal overlay and real-time alerts powered by QUANTA Signal Engine.",
  "update_url": "https://quanta.virtusol.com/extension/updates.xml",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://quanta.virtusol.com/*",
    "http://localhost:3002/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "QUANTA Intent Engine",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
